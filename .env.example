# Copy to a local .env file and replace all credential values.
# .env must never be committed. Use URL-encoding for special database password characters.
SITEPAY_ENVIRONMENT=development
SITEPAY_DATABASE_URL=postgresql+psycopg://sitepay:replace-with-local-password@localhost:5432/sitepay
SITEPAY_DB_PASSWORD=
SITEPAY_JWT_SECRET=
SITEPAY_JWT_MINUTES=30
SITEPAY_CORS_ORIGINS=http://localhost:5173
SITEPAY_ENABLE_EVIDENCE_PREVIEW=false
SITEPAY_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
SITEPAY_OBJECT_STORAGE_BUCKET=sitepay-evidence
SITEPAY_OBJECT_STORAGE_ACCESS_KEY=
SITEPAY_OBJECT_STORAGE_SECRET_KEY=
SITEPAY_AI_API_KEY=
SITEPAY_AI_MODEL=
